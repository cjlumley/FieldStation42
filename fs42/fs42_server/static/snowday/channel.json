{
  "_comment": "Snow Day live bumper pack config, read by the shared engine (static/bumpengine/engine.js). Schema: docs/LIVE_BUMPER_PACKS.md. shows: FS42 tag -> on-screen name. movies: tags that get the movie promo.",
  "templates": [
    "SnowBG",
    "SnowWordmark",
    "BumpBRB",
    "BumpBackTo",
    "BumpComingUp",
    "BumpCountdown",
    "BumpID",
    "BumpLineup",
    "BumpMerry",
    "BumpMovie",
    "BumpSting",
    "BumpTrivia",
    "BumpUpNext",
    "BumpUpNextThen"
  ],
  "fonts": [
    "800 40px \"Baloo 2\"",
    "700 20px \"Baloo 2\"",
    "800 20px Nunito",
    "700 20px Nunito"
  ],
  "themes": [
    "plaid",
    "night",
    "lights",
    "giftwrap",
    "hearth"
  ],
  "cues": {
    "post": [
      {
        "template": "BumpBackTo",
        "weight": 6,
        "when": "continues",
        "props": {
          "showName": "{cur}",
          "label": [
            "NOW BACK TO",
            "AND NOW, BACK TO",
            "WELCOME BACK TO",
            "RETURNING TO"
          ]
        }
      },
      {
        "template": "BumpSting",
        "weight": 1,
        "when": "continues"
      },
      {
        "template": "BumpUpNext",
        "weight": 4,
        "when": [
          "!continues",
          "next"
        ],
        "props": {
          "showName": "{next}",
          "time": "{nextTime}",
          "label": [
            "up next!",
            "coming up!",
            "next on snow day"
          ]
        }
      },
      {
        "template": "BumpUpNextThen",
        "weight": 2,
        "when": [
          "!continues",
          "next",
          "then"
        ],
        "props": {
          "showName": "{next}",
          "time": "{nextTime}",
          "thenName": "{then}",
          "thenTime": "{thenTime}"
        }
      },
      {
        "template": "BumpSting",
        "weight": 1,
        "when": [
          "!continues",
          "!next"
        ]
      }
    ],
    "pre": [
      {
        "template": "BumpBRB",
        "weight": 3,
        "props": {
          "line": [
            "we'll be right back!",
            "don't go anywhere!",
            "back in a jingle!",
            "stay cozy, back soon!"
          ],
          "art": [
            "gift",
            "cocoa",
            "snowman",
            "tree"
          ]
        }
      },
      {
        "template": "BumpComingUp",
        "weight": 2,
        "when": "continues",
        "props": {
          "header": [
            "stay tuned!",
            "don't touch that dial!",
            "more after this!",
            "stick around!"
          ],
          "tease": "more {cur}"
        }
      },
      {
        "template": "BumpComingUp",
        "weight": 2,
        "when": [
          "!continues",
          "next"
        ],
        "props": {
          "header": [
            "stay tuned!",
            "stick around!"
          ],
          "tease": "{next} is next"
        }
      },
      {
        "template": "BumpTrivia",
        "weight": 2,
        "props": {
          "fact": {
            "pick": "facts"
          },
          "header": [
            "did you know?",
            "snow day fact!",
            "holiday fun fact"
          ]
        }
      },
      {
        "template": "BumpCountdown",
        "weight": 3,
        "dates": [
          "12-01",
          "12-24"
        ],
        "props": {
          "sleeps": "{days:12-25}"
        }
      },
      {
        "template": "BumpMerry",
        "weight": 1,
        "props": {
          "greeting": [
            "merry christmas!",
            "happy holidays!",
            "season's greetings!"
          ]
        }
      },
      {
        "template": "BumpID",
        "weight": 1,
        "props": {
          "tag": {
            "pick": "ids"
          }
        }
      },
      {
        "template": "BumpLineup",
        "weight": 1,
        "when": "lineup",
        "props": {
          "header": {
            "byHour": {
              "0": "today on snow day",
              "16": "coming up tonight"
            }
          },
          "lineup": "{lineup}"
        }
      },
      {
        "template": "BumpMovie",
        "weight": 2,
        "when": "movie",
        "props": {
          "movieTitle": "{movie}",
          "when": {
            "byHour": {
              "0": "today at {movieTime}",
              "17": "tonight at {movieTime}"
            },
            "of": "movie"
          }
        }
      }
    ]
  },
  "lineup": {
    "size": 4,
    "min": 3
  },
  "shows": {
    "charlie_brown_christmas": "A Charlie Brown Christmas",
    "frosty": "Frosty the Snowman",
    "grinch": "How the Grinch Stole Christmas!",
    "mickeys_christmas_carol": "Mickey's Christmas Carol",
    "rudolph": "Rudolph the Red-Nosed Reindeer",
    "santa_claus_is_comin": "Santa Claus Is Comin' to Town",
    "year_without_santa": "The Year Without a Santa Claus",
    "elf": "Elf",
    "home_alone": "Home Alone",
    "home_alone_2": "Home Alone 2: Lost in New York",
    "miracle_on_34th_street": "Miracle on 34th Street",
    "muppet_christmas_carol": "The Muppet Christmas Carol",
    "christmas_vacation": "Christmas Vacation",
    "nightmare_before_christmas": "The Nightmare Before Christmas",
    "polar_express": "The Polar Express"
  },
  "movies": [
    "elf",
    "home_alone",
    "home_alone_2",
    "miracle_on_34th_street",
    "muppet_christmas_carol",
    "christmas_vacation",
    "nightmare_before_christmas",
    "polar_express"
  ],
  "facts": [
    "Santa's postal code in Canada is H0H 0H0, and Canada Post answers his letters every year.",
    "Toronto's Santa Claus Parade began in 1905, when Santa arrived by train and rode to Eaton's.",
    "Rudolph was created in 1939 as a free booklet for Montgomery Ward shoppers.",
    "A Charlie Brown Christmas first aired in 1965.",
    "Every year, Nova Scotia sends Boston a giant Christmas tree to say thanks for its help after the 1917 Halifax Explosion.",
    "Jingle Bells was played in space in 1965 by the Gemini 6 astronauts, on a harmonica and bells.",
    "The 1966 Grinch special was narrated by Boris Karloff.",
    "Reindeer and caribou are the same species.",
    "Snowflakes almost always have six sides.",
    "It's a Wonderful Life wasn't a hit when it came out in 1946. TV reruns made it a classic."
  ],
  "genericTeases": [
    "more holiday favourites",
    "more cozy specials",
    "more snow day"
  ],
  "ids": [
    "all December · channel 12",
    "cozy holiday specials all month",
    "your home for the holidays",
    "the most wonderful channel of the year"
  ]
}
